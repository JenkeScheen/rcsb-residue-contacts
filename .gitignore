# Local data and the RCSB download cache. Never commit.
data/
.rcsb_cache/

# Bulky structure / molecule files anywhere
*.pdb
*.ent
*.cif
*.cif.gz
*.mol2
*.sdf
*.mmtf
*.bcif

# Keep small test fixtures under tests/ tracked
!tests/**/*.pdb
!tests/**/*.sdf
!tests/**/*.mol2
!tests/**/*.cif

# Pipeline outputs. The curated example run in examples/HIS-face-to-face/ is tracked in full:
# tables, plots (incl. the README figure) and its ~1 MB of example pocket structures.
results/
/examples/*
!/examples/HIS-face-to-face/
!/examples/HIS-face-to-face/examples/**/*.pdb
!/examples/HIS-face-to-face/examples/**/*.cif

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/
.conda/

# Editor / OS
.idea/
.vscode/
.DS_Store
